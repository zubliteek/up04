<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Заявки"
        Height="600" Width="1000"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="HelpDesk"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Система обработки заявок"
                           FontSize="14"
                           Opacity="0.7"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center"
                            Margin="0,0,15,0">

                    <TextBlock x:Name="CurrentUserTextBlock"
                               Text="Пользователь: admin"
                               FontSize="14"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="CurrentDateTextBlock"
                               FontSize="12"
                               Opacity="0.7"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button x:Name="LogoutButton"
                        Content="Выйти"
                        Width="90"
                        ToolTip="Выйти из учётной записи"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LogoutButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Поиск"
                           Margin="0,0,0,5"/>

                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             Height="32"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="Поиск по описанию, категории и статусу"
                             KeyDown="SearchTextBox_KeyDown"/>

                    <TextBlock Text="Описание, категория или статус заявки…"
                               Foreground="Gray"
                               FontSize="14"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

            </StackPanel>

            <StackPanel Grid.Column="2">

                <TextBlock Text="Статус"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="StatusComboBox"
                          Height="32"
                          FontSize="14"
                          SelectedIndex="0"
                          SelectionChanged="StatusComboBox_SelectionChanged"/>

            </StackPanel>

            <Button x:Name="SearchButton"
                    Grid.Column="4"
                    Content="Найти"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Cursor="Hand"
                    ToolTip="Применить поиск и фильтр"
                    Click="SearchButton_Click"/>

            <Button x:Name="ResetFilterButton"
                    Grid.Column="6"
                    Content="Сбросить"
                    Height="32"
                    VerticalAlignment="Bottom"
                    Cursor="Hand"
                    ToolTip="Очистить поиск и показать все заявки"
                    Click="ResetFilterButton_Click"/>
        </Grid>

        <DataGrid x:Name="TicketsDataGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  MouseDoubleClick="TicketsDataGrid_MouseDoubleClick">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Новая">
                            <Setter Property="Background" Value="#FFE8F2FF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="В работе">
                            <Setter Property="Background" Value="#FFFFF4D6"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Выполнена">
                            <Setter Property="Background" Value="#FFE6F4E6"/>
                            <Setter Property="Foreground" Value="#FF6B6B6B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Отклонена">
                            <Setter Property="Background" Value="#FFF8E1E1"/>
                            <Setter Property="Foreground" Value="#FF6B6B6B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="Высокий">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF3A7BD5"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="140"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <DataGridTextColumn Header="Приоритет"
                                    Binding="{Binding Priority}"
                                    Width="110"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="120"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TicketsCountTextBlock"
                       Grid.Column="0"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="AddTicketButton"
                        Content="Добавить"
                        Width="120"
                        ToolTip="Создать новую заявку"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddTicketButton_Click"/>

                <Button x:Name="EditTicketButton"
                        Content="Редактировать"
                        Width="120"
                        ToolTip="Редактировать выбранную заявку (или двойной щелчок по строке)"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="EditTicketButton_Click"/>

                <Button x:Name="DeleteTicketButton"
                        Content="Удалить"
                        Width="120"
                        ToolTip="Удалить выбранную заявку"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="DeleteTicketButton_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
