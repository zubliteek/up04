<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки"
        Height="680" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Редактирование заявки"
                   Style="{StaticResource TitleTextStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <TextBlock x:Name="TicketIdTextBlock"
                   Grid.Row="1"
                   Text="Заявка №: 0"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2"
                   Text="Категория"
                   Style="{StaticResource FieldLabelStyle}"/>

        <ComboBox x:Name="CategoryComboBox"
                  Grid.Row="3"
                  Height="35"
                  FontSize="14"
                  Margin="0,0,0,12">

            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>

        </ComboBox>

        <TextBlock Grid.Row="4"
                   Text="Описание"
                   Style="{StaticResource FieldLabelStyle}"/>

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="5"
                 FontSize="14"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="6"
                   Text="Приоритет"
                   Style="{StaticResource FieldLabelStyle}"/>

        <ComboBox x:Name="PriorityComboBox"
                  Grid.Row="7"
                  Height="35"
                  FontSize="14"
                  Margin="0,0,0,12">

            <ComboBoxItem Content="Низкий"/>
            <ComboBoxItem Content="Средний"/>
            <ComboBoxItem Content="Высокий"/>

        </ComboBox>

        <TextBlock Grid.Row="8"
                   Text="Статус"
                   Style="{StaticResource FieldLabelStyle}"/>

        <ComboBox x:Name="StatusComboBox"
                  Grid.Row="9"
                  Height="35"
                  FontSize="14">

            <ComboBoxItem Content="Новая"/>
            <ComboBoxItem Content="В работе"/>
            <ComboBoxItem Content="Выполнена"/>
            <ComboBoxItem Content="Отклонена"/>

        </ComboBox>

        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button x:Name="SaveButton"
                    Content="Сохранить изменения"
                    Width="170"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SaveButton_Click"/>

            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Width="130"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
